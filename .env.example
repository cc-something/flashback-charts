# Canonical site URL used for sitemap.xml, robots.txt, canonical tags, and og:url meta.
# Include protocol; no trailing slash.
VITE_SITE_URL=https://flashbackcharts.com

# Fathom Analytics site ID. Leave unset to disable tracking (dev/preview).
VITE_FATHOM_SITE_ID=

# Buttondown API key for email newsletter signups.
VITE_BUTTONDOWN_API_KEY=

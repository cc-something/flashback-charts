# Flashback Charts Australia — Apache config for cPanel hosting.
# vite-ssg prerenders /au/index.html, /au/YYYY/index.html, etc.
# Redirect bare root to /au; serve prerendered files directly; fall back to
# /au/index.html for any unmatched path so deep links and refreshes work.

Options -MultiViews
RewriteEngine On

# Redirect bare root to /au/.
RewriteRule ^$ /au/ [R=301,L]

# Skip rewrite for real files and directories (assets, prerendered HTML, sitemap, etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Fall back to the /au SPA entry for everything else.
RewriteRule ^ au/index.html [L]

# Long-cache hashed assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip text responses.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
